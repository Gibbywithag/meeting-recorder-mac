# Meeting Recorder settings. The app keeps its own copy at
#   ~/Library/Application Support/MeetingRecorder/.env
# You don't need to edit this: the app asks for your key the first time you press Start.

# Google Gemini API key (create one at https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Optional: GEMINI_MODEL=gemini-3-flash-preview

# Your name(s) as people say them on calls, comma separated (helps label your lines).
# LOCAL_SPEAKER_NAMES=Sam,Sammy

# Name used for you in the finished PDF, and spelling fixes for words Gemini mishears (misheard=correct;...).
# REPORT_NAME=Sam
# REPORT_FIXES=Acmee=Acme
